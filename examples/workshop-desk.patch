      radio "Ready", "Review", "Blocked" as gallery_mode
      combo "Blue", "Green", "Amber", "Red" as gallery_color
      # @listbox-mode checked
      listbox "Designer", "Compiler", "Runtime", "Offline" as gallery_features
      slider 0..100 as gallery_level step 10
      # @slider-mode progress
      slider 0..100 as gallery_progress step 1
      # @slider-mode scrollbar
      slider 0..100 as gallery_scroll step 5
      # @button-mode link
      button "LinkLabel action" as gallery_link
    tab "Calendar":
      text "Calendar Stage 1 keeps ISO date text in ordinary Patch state"
      # @input-mode calendar
      input gallery_calendar
      text "Selected date {gallery_calendar}"
    tab "Data":
      text "Advanced Table columns and TreeView node image, hint and state metadata"
      # @table-columns 150:left, 180:left, 120:center
      table "Component", "Contract", "Surface" as gallery_table:
        row "Memo", "changed(value)", "Studio/Web"
        row "Calendar", "ISO date text", "Studio/Web"
        row "TreeView", "path list", "Studio/Web"
        row "Table", "advanced columns", "Studio/Web"
      tree as gallery_tree:
        node "Component Registry 0.10" image gallery_images.mark hint "Feature Lab root" state info
          node "Inputs" image gallery_images.mark hint "Input presentations" state success
            node "Memo" image gallery_images.mark hint "Multiline text" state muted
          node "Data" image gallery_images.mark hint "Structured controls" state warning
            node "TreeView" image gallery_images.mark hint "Node metadata" state success
    tab "Containers":
      text "GroupBox, ScrollBox and SplitContainer are shown below the tabs because container controls stay top-level in Tabs Stage 1."
      button "Focus container demos" as gallery_container_focus
    tab "Graphics":
      text "Project graphics, Separator preset, PaintBox and ImageList-backed Button"
      picture as gallery_picture from "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAYAAABzenr0AAAAo0lEQVR42mP88evPf4YBBEwMAwxGHcCCT1I38z2cfXm6IFZxfABZDy7AiC0REmsBsQCfQ+gSBfg8xERr3xMyd3AnQnLjFZdvdTPfY+hjorblxKZ+sh1ArOHEqht6JSGxuYRYdUzUztf45LFFCwstCpdBWRnhSpRMA2k5RVFArazIQiuDR1tEow4YdQDZDqBmXT8kQoARX98QV7+Abg4YzQX0AAAIsD5sBwsk2AAAAABJRU5ErkJggg==" description "Workshop Feature Lab picture"
      # @locked
      shape rounded as gallery_shape fill #dbeafe stroke #2563eb stroke-width 2 radius 14 opacity 1
      # @locked
      shape line as gallery_separator fill transparent stroke #94a3b8 stroke-width 1 radius 0 opacity 1
      paintbox as gallery_canvas
      button "Resource button" as gallery_resource_button

  # @panel-mode group
  panel as gallery_group at 16, 432 size 300, 160:
    text "GroupBox presentation"
    button "Group action" as gallery_group_action

  # @panel-scroll auto
  panel as gallery_scrollbox at 328, 432 size 300, 160:
    text "ScrollBox keeps viewport state transient"
    button "ScrollBox action" as gallery_scroll_action
    text "Overflow content exercises a real scroll viewport."
    text "No hidden application state is created by scrolling."

  panel as gallery_split at 640, 432 size 324, 160:
