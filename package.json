{
  "name": "patch-lang",
  "version": "0.2.0-beta.35",
  "description": "Patch: a tiny change-oriented programming language with semantic Change Contracts, Lean-checked finite transitive exact call trees, invocation-frame-aware direct-Wasm correspondence, source-backed Patch Studio, verified native runtime templates, cross-platform builds, direct WebAssembly and portable C99/FreeBSD execution",
  "type": "module",
  "bin": {
    "patch": "./src/cli-entry.js",
    "patch-app": "./scripts/build-native-gui.js"
  },
  "scripts": {
    "test": "node --test",
    "run": "node src/cli.js run",
    "doctor": "node src/cli-entry.js doctor --json",
    "run:wasm-direct": "node src/cli.js run-wasm examples/direct-wasm-recipes.patch",
    "validate:wasm-direct": "node scripts/validate-direct-trace.js examples/direct-wasm-recipes.patch",
    "serve": "node scripts/serve.js",
    "check": "node scripts/check-examples.js",
    "check:project": "node scripts/check-project-surface.js && node scripts/check-checkout-extension-surface.js",
    "fuzz:compiler": "node scripts/fuzz-compiler.js --seed 20260812 --cases 500",
    "test:differential": "node scripts/differential-backends.js",
    "formal:example": "node src/cli.js formal examples/range-soundness.patch",
    "certify:example": "node src/cli.js certify examples/range-soundness.patch --out formal/GeneratedCertificate.lean",
    "runtime-certify:example": "node src/cli.js runtime-certify examples/runtime-correspondence.patch --out formal/GeneratedRuntimeCertificate.lean",
    "call-certify:example": "node scripts/generate-call-certificate.js examples/formal-calls.patch --out formal/GeneratedCallCertificate.lean",
    "concrete-call-certify:example": "node scripts/generate-concrete-call-certificate.js examples/formal-calls.patch --out formal/GeneratedConcreteCallCertificate.lean",
    "arithmetic-call-certify:example": "node scripts/generate-concrete-call-certificate.js examples/formal-calls-arithmetic.patch --out formal/GeneratedArithmeticCallCertificate.lean",
    "callee-trace-certify:example": "node scripts/generate-concrete-call-body-certificate.js examples/formal-callee-trace.patch --out formal/GeneratedConcreteCallBodyCertificate.lean",
    "guarded-callee-trace-certify:example": "node scripts/generate-concrete-call-body-certificate.js examples/formal-callee-guard.patch --out formal/GeneratedGuardedCallBodyCertificate.lean",
    "transitive-callee-trace-certify:example": "node scripts/generate-transitive-call-body-certificate.js examples/formal-transitive-calls.patch --out formal/GeneratedTransitiveCallBodyCertificate.lean",
    "transitive-runtime-certify:example": "node scripts/generate-transitive-runtime-certificate.js examples/formal-transitive-calls.patch --out formal/GeneratedTransitiveRuntimeCertificate.lean",
    "transitive-runtime-certify:repeated": "node scripts/generate-transitive-runtime-certificate.js examples/formal-transitive-calls-repeated.patch --out formal/GeneratedRepeatedTransitiveRuntimeCertificate.lean",
    "transitive-runtime-certify:mixed-guards": "node scripts/generate-transitive-runtime-certificate.js examples/formal-transitive-calls-mixed-guards.patch --out formal/GeneratedMixedGuardTransitiveRuntimeCertificate.lean",
    "evaluate:assurance": "node scripts/benchmark-assurance.js",
    "evaluate:assurance:quick": "node scripts/benchmark-assurance.js --preset quick --iterations 3 --warmup 1",
    "evaluate:assurance:isolated": "node scripts/run-controlled-assurance.js --preset quick --runs 3 --iterations 3 --warmup 1 --measurement-class development",
    "evaluate:assurance:controlled": "node scripts/run-controlled-assurance.js --measurement-class controlled",
    "evaluate:security": "node scripts/evaluate-security-cases.js",
    "evaluate:checkout-extension": "node scripts/evaluate-checkout-extension.js",
    "evaluate:quota-extension": "node scripts/evaluate-extension-case.js --case quota-extension",
    "bundle:reproducibility": "node scripts/reproducibility-bundle.js build --out reproducibility/bundle",
    "verify:reproducibility": "node scripts/reproducibility-bundle.js verify --bundle reproducibility/bundle",
    "build:example": "node src/cli.js build examples/score.patch --kind console --target portable --out Score.patchapp",
    "build:wasm": "node src/cli.js build examples/score.patch --kind console --target wasm --out Score.wasm",
    "build:wasm-direct": "node src/cli.js build examples/direct-wasm-recipes.patch --kind console --target wasm-direct --out DirectRecipes.wasm",
    "build:c99": "node src/cli.js build examples/direct-wasm-recipes.patch --kind console --target c99 --out DirectRecipes.c",
    "build:web": "node src/cli.js build examples/direct-wasm-recipes.patch --kind console --target web --out DirectRecipes.html",
    "build:native": "node src/cli.js build examples/direct-wasm-recipes.patch --kind console --target native --name DirectRecipes",
    "build:app": "node src/cli.js build examples/direct-wasm-recipes.patch --kind console --target app --name DirectRecipes",
    "build:native-gui": "node scripts/build-native-gui.js examples/forms-navigation.patch NativeForms dist-native",
    "build:offline-compiler": "node scripts/build-offline-compiler.js",
    "release:manifest:example": "node scripts/release-manifest.js --out-dir release-meta Score.patchapp Score.wasm DirectRecipes.wasm DirectRecipes.c DirectRecipes.html CounterWindow.html",
    "build:site": "node scripts/build-site.js",
    "check:site": "node scripts/check-site.js && node scripts/check-site-v10.js && node scripts/check-site-v12.js && node scripts/check-site-beta35.js"
  },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "keywords": ["programming-language", "change-oriented-programming", "semantic-patches", "change-capabilities", "semantic-authority", "security-case-study", "extension-case-study", "effect-system", "formal-verification", "lean4", "range-analysis", "abstract-interpretation", "signature-soundness", "translation-validation", "source-validation", "guard-validation", "guard-aware-runtime", "runtime-correspondence", "runtime-path-witness", "runtime-capability-containment", "formal-recipe-calls", "call-signature-composition", "concrete-call-binding", "arithmetic-call-binding", "structured-callee-trace", "guarded-callee-trace", "transitive-callee-trace", "transitive-runtime-correspondence", "call-aware-wasm-correspondence", "invocation-frame-correspondence", "assurance-evaluation", "benchmark", "finite-call-tree", "effect-refinement", "verified-checker", "verified-evidence", "source-correspondence", "proof-carrying-code", "causal-provenance", "education", "time-travel-debugging", "compiler", "offline-compiler", "pwa", "cross-platform", "gui", "ide", "webassembly", "direct-wasm", "c99", "freebsd", "unix", "standalone-web-app", "window-web-app", "window-input-events", "semantic-input", "native-app", "native-gui-app", "macos-app", "windows-exe", "linux-executable", "control-flow", "recipes", "runtime-guards", "semantic-trace", "trace-contract", "effect-validation", "release-integrity", "runtime-integrity", "reproducibility", "artifact-evaluation", "diagnostics"]
}