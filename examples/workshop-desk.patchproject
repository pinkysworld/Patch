2\", \"Reorder\"\n    row \"CB-119\", \"Display cable\", \"Main store\", \"18\", \"Available\"\n    row \"DR-301\", \"Precision driver\", \"Bench A\", \"7\", \"Available\"\n    row \"SL-044\", \"Solder\", \"Overflow\", \"3\", \"Low\"\n\n  tree as inventory_tree at 588, 154 size 280, 310:\n    node \"Stock\"\n      node \"Input devices\"\n        node \"Keyboard\"\n        node \"Trackpad\"\n      node \"Displays\"\n        node \"Display panel\"\n        node \"Display cable\"\n      node \"Tools\"\n        node \"Precision driver\"\n        node \"Solder\"\n    node \"Locations\"\n      node \"Main store\"\n      node \"Bench A\"\n      node \"Bench B\"\n      node \"Overflow\"\n\n  button \"Prepare reorder\" as reorder_button at 24, 500 size 170, 38\n  button \"Open job details\" as inventory_details at 210, 500 size 170, 38\n  button \"Close inventory\" as close_inventory at 396, 500 size 170, 38\n  statusbar \"{inventory_status}\" as inventory_statusbar at 0, 592 size 900, 28\n\nwindow \"Customer Profile\" as customer_profile size 760, 600:\n  text \"Customer Profile\" at 24, 20 size 280, 30\n  text \"{customer_status}\" at 318, 20 size 410, 30\n  text \"Name\" at 24, 68 size 100, 22\n  text \"{customer}\" at 24, 92 size 220, 36\n  text \"Email\" at 268, 68 size 100, 22\n  input customer_email at 268, 92 size 300, 36\n  text \"Tier\" at 590, 68 size 100, 22\n  combo \"Standard\", \"Silver\", \"Gold\", \"Platinum\" as customer_tier at 590, 92 size 140, 36\n  checkbox \"Marketing updates\" as customer_marketing at 24, 150 size 190, 36\n  text \"Preferred channels\" at 238, 150 size 160, 22\n  listbox \"Email\", \"SMS\", \"Phone\", \"Portal\" as customer_channels at 238, 176 size 220, 110\n  text \"Account note\" at 482, 150 size 150, 22\n  input customer_note at 482, 176 size 248, 38\n\n  table \"Ticket\", \"Item\", \"State\", \"Quote\" as customer_jobs at 24, 318 size 706, 150:\n    row \"WD-104\", \"Keyboard\", \"Open\", \"40\"\n    row \"WD-091\", \"Display panel\", \"Ready\", \"210\"\n    row \"WD-076\", \"Trackpad\", \"Closed\", \"85\"\n\n  button \"Save profile\" as customer_save at 24, 496 size 150, 38\n  button \"Open current job\" as customer_job at 190, 496 size 170, 38\n  button \"Close profile\" as close_customer at 376, 496 size 150, 38\n  statusbar \"{customer_status}\" as customer_statusbar at 0, 572 size 760, 28\n\nwindow \"Workshop Diagnostics\" as diagnostics size 840, 620:\n  text \"Workshop Diagnostics\" at 24, 20 size 300, 30\n  text \"{diagnostic_status}\" at 338, 20 size 470, 30\n  tabs as diagnostic_tabs at 24, 72 size 792, 270:\n    tab \"Runtime\":\n      text \"Runtime mode\"\n      radio \"Runtime\", \"Designer\", \"Native\" as diagnostic_mode\n      checkbox \"Trace semantic changes\" as trace_enabled\n      text \"Sampling interval {diagnostic_interval}s\"\n      slider 1..10 as diagnostic_interval step 1\n    tab \"Build\":\n      text \"Offline compiler and sealed runtime readiness\"\n      text \"Use Downloads for platform compiler and Offline Studio bundles.\"\n      text \"Current desktop Ready runtime contract: v1.10.\"\n    tab \"Quality\":\n      text \"Designer materializes one active Form while preserving source-backed shells.\"\n      text \"Workshop Desk exercises seven Forms and the Current Ready subset of Component Registry 0.10.\"\n      text \"Diagnostic runs: {diagnostic_runs} · runtime pulses: {diagnostic_ticks}\"\n    tab \"Environment\":\n      text \"Browser, Offline Studio and generated Web App share the same source.\"\n      text \"Native capability gates remain fail-closed for unsupported resources.\"\n\n  table \"Check\", \"Surface\", \"State\" as diagnostic_checks at 24, 370 size 540, 150:\n    row \"Designer\", \"Active Form materialization\", \"Ready\"\n    row \"Compiler\", \"Window Web App\", \"Ready\"\n    row \"Runtime\", \"Desktop v1.10\", \"Ready\"\n    row \"Offline\", \"Studio Stage 1\", \"Ready\"\n\n  button \"Run checks\" as diagnostic_run at 590, 370 size 190, 38\n  button \"Open settings\" as diagnostic_settings at 590, 418 size 190, 38\n  button \"Close diagnostics\" as close_diagnostics at 590, 466 size 190, 38\n  timer as diagnostics_clock interval 3000\n  statusbar \"{diagnostic_status}\" as diagnostic_statusbar at 0, 592 size 840, 28\n\nwindow \"Studio Feature Lab\" as components size 980, 700:\n  menu \"Lab\":\n    item \"Confirm action...\" as gallery_menu_confirm shortcut \"Primary+K\"\n    item \"Open file...\" as gallery_menu_open shortcut \"Primary+O\"\n    item \"Save file...\" as gallery_menu_save shortcut \"Primary+S\"\n    separator\n    item \"Enabled\" as gallery_menu_enabled checked gallery_enabled shortcut \"Primary+E\"\n  menu \"Help\":\n    item \"About Feature Lab\" as gallery_menu_about shortcut \"F1\"\n\n  # @locked\n  shape rounded as gallery_header fill #ecfeff stroke #bae6fd stroke-width 1 radius 18 opacity 1 at 16, 12 size 948, 64\n  text \"Studio Feature Lab\" at 32, 22 size 300, 26\n  text \"{gallery_status}\" at 346, 22 size 590, 26\n  text \"Complete current Studio/Web acceptance surface · Component Registry 0.10\" at 32, 48 size 700, 20\n\n  imagelist as gallery_images size 20, 20:\n    image mark from \"patch-resource:workshop.mark\"\n\n  tabs as feature_tabs at 16, 88 size 948, 536:\n    tab \"Inputs\":\n      text \"Text, Memo and all current source-backed Input presentations\"\n      input gallery_text\n      memo gallery_memo\n      # @input-mode password\n      input gallery_secret\n      # @input-mask \"AA-000\"\n      input gallery_mask\n      # @number-edit\n      input gallery_number\n      # @input-mode date\n      input gallery_date\n      # @input-mode time\n      input gallery_time\n    tab \"Choices\":\n      text \"Core choices plus CheckedListBox, ProgressBar, ScrollBar and LinkLabel\"\n      checkbox \"Enabled\" as gallery_enabled\n      radio \"Ready\", \"Review\", \"Blocked\" as gallery_mode\n      combo \"Blue\", \"Green\", \"Amber\", \"Red\" as gallery_color\n      # @listbox-mode checked\n      listbox \"Designer\", \"Compiler\", \"Runtime\", \"Offline\" as gallery_features\n      slider 0..100 as gallery_level step 10\n      # @slider-mode progress\n      slider 0..100 as gallery_progress step 1\n      # @slider-mode scrollbar\n      slider 0..100 as gallery_scroll step 5\n      # @button-mode link\n      button \"LinkLabel action\" as gallery_link\n    tab \"Calendar\":\n      text \"Calendar Stage 1 keeps ISO date text in ordinary Patch state\"\n      # @input-mode calendar\n      input gallery_calendar\n      text \"Selected date {gallery_calendar}\"\n    tab \"Data\":\n      text \"Advanced Table columns and TreeView node image, hint and state metadata\"\n      # @table-columns 150:left, 180:left, 120:center\n      table \"Component\", \"Contract\", \"Surface\" as gallery_table:\n        row \"Memo\", \"changed(value)\", \"Studio/Web\"\n        row \"Calendar\", \"ISO date text\", \"Studio/Web\"\n        row \"TreeView\", \"path list\", \"Studio/Web\"\n        row \"Table\", \"advanced columns\", \"Studio/Web\"\n      tree as gallery_tree:\n        node \"Component Registry 0.10\" image gallery_images.mark hint \"Feature Lab root\" state info\n          node \"Inputs\" image gallery_images.mark hint \"Input presentations\" state success\n            node \"Memo\" image gallery_images.mark hint \"Multiline text\" state muted\n          node \"Data\" image gallery_images.mark hint \"Structured controls\" state warning\n            node \"TreeView\" image gallery_images.mark hint \"Node metadata\" state success\n    tab \"Containers\":\n      text \"GroupBox, ScrollBox and SplitContainer reuse the source-backed Panel model\"\n      # @panel-mode group\n      panel as gallery_group:\n        text \"GroupBox presentation\"\n        button \"Group action\" as gallery_group_action\n      # @panel-scroll auto\n      panel as gallery_scrollbox:\n        text \"ScrollBox keeps viewport state transient\"\n        button \"ScrollBox action\" as gallery_scroll_action\n      panel as gallery_split:\n        # @panel-split vertical 42\n        text \"Navigator pane\"\n        button \"Navigate\" as gallery_split_left\n        # @panel-split-break\n        text \"Preview pane\"\n        button \"Preview\" as gallery_split_right\n    tab \"Graphics\":\n      text \"Project graphics, Separator preset, PaintBox and ImageList-backed Button\"\n      picture as gallery_picture from \"patch-resource:workshop.mark\" description \"Workshop Feature Lab picture\"\n      # @locked\n      shape rounded as gallery_shape fill #dbeafe stroke #2563eb stroke-width 2 radius 14 opacity 1\n      # @locked\n      shape line as gallery_separator fill transparent stroke #94a3b8 stroke-width 1 radius 0 opacity 1\n      paintbox as gallery_canvas\n      button \"Resource button\" as gallery_resource_button image gallery_images.mark\n\n  button \"Refresh demo\" as gallery_refresh image gallery_images.mark at 620, 642 size 160, 32\n  button \"Close Feature Lab\" as close_components at 792, 642 size 172, 32\n  timer as gallery_clock interval 2000\n  statusbar \"{gallery_status} · progress {gallery_progress}% · pulse {gallery_ticks}\" as gallery_statusbar at 0, 672 size 980, 28\n"
