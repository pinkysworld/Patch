      "path": "main.patch",
      "content": "create text customer = \"Ada\"\ncreate text item = \"Keyboard\"\ncreate number qty = 1\ncreate boolean rush = false\ncreate text priority = \"Normal\"\ncreate text pay = \"Card\"\ncreate text notes = \"\"\ncreate list services = [\"Diagnostics\"]\ncreate text status = \"Ready for the next workshop ticket.\"\ncreate boolean notifications = true\ncreate text default_bench = \"Bench A\"\ncreate list stations = [\"Bench A\", \"Bench B\"]\ncreate text density = \"Comfortable\"\ncreate number labor_limit = 50\ncreate number heartbeat = 0\ncreate number ticket_total = 40\ncreate number base_rate = 25\ncreate number inspection_fee = 15\ncreate number rush_fee = 20\ncreate number quote_revision = 0\ncreate text ticket_bench = \"Bench A\"\ncreate text ticket_state = \"Open\"\ncreate text inventory_filter = \"All stock\"\ncreate text inventory_zone = \"Main store\"\ncreate number reorder_qty = 5\ncreate text inventory_status = \"Inventory synchronized\"\ncreate text customer_email = \"ada@example.com\"\ncreate text customer_tier = \"Gold\"\ncreate boolean customer_marketing = true\ncreate list customer_channels = [\"Email\"]\ncreate text customer_note = \"Priority account\"\ncreate text customer_status = \"Customer profile ready\"\ncreate text diagnostic_mode = \"Runtime\"\ncreate boolean trace_enabled = true\ncreate number diagnostic_interval = 5\ncreate number diagnostic_runs = 0\ncreate text diagnostic_status = \"All systems ready\"\ncreate text gallery_text = \"Workshop sample\"\ncreate boolean gallery_enabled = true\ncreate text gallery_mode = \"Ready\"\ncreate text gallery_color = \"Blue\"\ncreate list gallery_features = [\"Designer\"]\ncreate number gallery_level = 60\ncreate text gallery_status = \"Component gallery ready\"\ncreate number gallery_ticks = 0\ncreate text gallery_memo = \"Feature Lab notes\"\ncreate text gallery_secret = \"\"\ncreate text gallery_mask = \"\"\ncreate text gallery_number = \"42\"\ncreate text gallery_date = \"2026-09-25\"\ncreate text gallery_time = \"14:30\"\ncreate text gallery_calendar = \"2026-09-25\"\ncreate number gallery_progress = 40\ncreate number gallery_scroll = 25\ncreate text gallery_path = \"No file selected\"\ncreate text ticket_id = \"WD-104\"\ncreate list selected_job = [\"WD-104\", \"Ada\", \"Bench A\", \"Open\"]\ncreate list selected_part = [\"Parts\", \"Input\", \"Keyboard\"]\ncreate number service_fee = 15\ncreate number customer_saves = 0\ncreate number diagnostic_ticks = 0\n\nwindow \"Workshop Desk\" as main size 1080, 720 icon \"patch-resource:workshop.mark\":\n  # @locked\n  shape rounded as desk_header fill #eef2ff stroke #c7d2fe stroke-width 1 radius 18 opacity 1 at 16, 12 size 1048, 76\n  picture as workshop_logo from \"patch-resource:workshop.mark\" description \"Workshop mark\" at 28, 24 size 52, 52\n  text \"Workshop Desk\" at 96, 20 size 280, 28\n  text \"{status}\" at 96, 50 size 500, 24\n  text \"{ticket_id} · quote {ticket_total} · {ticket_state} · rev {quote_revision}\" at 620, 20 size 420, 28\n  text \"Project v4 · Studio/Web · native fixture separate\" at 620, 50 size 420, 22\n\n  imagelist as desk_images size 20, 20:\n    image mark from \"patch-resource:workshop.mark\"\n\n  # @locked\n  shape rounded as ticket_card fill #ffffff stroke #dbe3ef stroke-width 1 radius 16 opacity 1 at 16, 100 size 1048, 248\n  text \"Ticket\" at 32, 112 size 120, 24\n  text \"Customer\" at 32, 144 size 100, 20\n  combo \"Ada\", \"Grace\", \"Linus\", \"Margaret\" as customer at 32, 168 size 200, 36\n  text \"Item\" at 248, 144 size 80, 20\n  input item at 248, 168 size 240, 36\n  text \"Quantity {qty}\" at 508, 144 size 140, 20\n  slider 1..8 as qty step 1 at 508, 168 size 210, 36\n  checkbox \"Rush bench\" as rush at 740, 168 size 160, 36\n\n  text \"Payment\" at 32, 220 size 90, 20\n  radio \"Card\", \"Cash\", \"Account\" as pay at 32, 244 size 220, 84\n  text \"Priority\" at 272, 220 size 90, 20\n  radio \"Normal\", \"High\", \"Critical\" as priority at 272, 244 size 220, 84\n  text \"Notes\" at 512, 220 size 80, 20\n  input notes at 512, 244 size 250, 36\n  text \"Services\" at 780, 220 size 90, 20\n  listbox \"Diagnostics\", \"Warranty\", \"Install\", \"Pickup\" as services at 780, 244 size 260, 84\n\n  # @locked\n  shape rounded as queue_card fill #ffffff stroke #dbe3ef stroke-width 1 radius 16 opacity 1 at 16, 360 size 640, 292\n  text \"Queue\" at 32, 372 size 120, 22\n  table \"Ticket\", \"Customer\", \"Bench\", \"State\" as board at 32, 402 size 608, 230:\n    row \"WD-104\", \"Ada\", \"Bench A\", \"Open\"\n    row \"WD-105\", \"Grace\", \"Bench B\", \"Quoted\"\n    row \"WD-106\", \"Linus\", \"Bench A\", \"Ready\"\n    row \"WD-107\", \"Margaret\", \"Overflow\", \"Waiting\"\n\n  # @locked\n  shape rounded as side_card fill #ffffff stroke #dbe3ef stroke-width 1 radius 16 opacity 1 at 668, 360 size 396, 292\n  text \"Parts & tools\" at 684, 372 size 180, 22\n  tree as parts at 684, 400 size 168, 232:\n    node \"Parts\"\n      node \"Input\"\n        node \"Keyboard\"\n        node \"Trackpad\"\n      node \"Displays\"\n        node \"Panel\"\n        node \"Cable\"\n    node \"Tools\"\n      node \"Driver\"\n      node \"Solder\"\n      node \"Meter\"\n  button \"Quote\" as quote_button at 864, 400 size 180, 32\n  button \"Details\" as details_button at 864, 438 size 180, 32\n  button \"Ready\" as complete_button at 864, 476 size 180, 32\n  button \"Reset\" as reset_button at 864, 514 size 180, 32\n  button \"Inventory\" as inventory_button at 864, 552 size 86, 30\n  button \"Customer\" as customer_button at 958, 552 size 86, 30\n  button \"Diagnostics\" as diagnostics_button at 864, 588 size 86, 30\n  button \"Settings\" as settings_button at 958, 588 size 86, 30\n  button \"Studio Features\" as components_button image desk_images.mark at 864, 622 size 180, 28\n\n  # @layout anchor left right bottom\n  text \"Seven-Form working app · queue, quote, customer and inventory state persist through explicit change; Components shows the Current Ready native subset.\" at 16, 660 size 1048, 22\n  timer as workshop_clock interval 5000\n  statusbar \"{status}\" as desk_status at 0, 692 size 1080, 28\n\nwindow \"Workshop settings\" as settings size 720, 520:\n  tabs as prefs at 24, 24 size 672, 400:\n    tab \"Workflow\":\n      text \"Default bench\"\n      combo \"Bench A\", \"Bench B\", \"Overflow\" as default_bench\n      checkbox \"Notify when a quote changes\" as notifications\n      text \"Available stations\"\n      listbox \"Bench A\", \"Bench B\", \"Overflow\" as stations\n    tab \"Limits\":\n      text \"Labor approval limit {labor_limit}\"\n      slider 0..100 as labor_limit step 10\n      text \"This tab demonstrates a nested Slider and shared persistent state.\"\n    tab \"Appearance\":\n      radio \"Compact\", \"Comfortable\", \"Spacious\" as density\n      text \"Density is source-backed application state, not hidden Designer metadata.\"\n    tab \"About\":\n      text \"Workshop Desk is the Patch Studio seven-Form RAD showcase project.\"\n      text \"It covers the Current Ready subset of Component Registry 0.10, including nonvisual Timer and ImageList authoring.\"\n      text \"Current Ready desktop contract: Native GUI IR 1.9 / payload v19 / runtime v1.10.\"\n      button \"Close\" as close_about\n  button \"Close settings\" as close_settings at 24, 448 size 170, 38\n\nwindow \"Job details\" as details size 640, 560:\n  # @locked\n  shape rounded as details_header fill #eef2ff stroke #c7d2fe stroke-width 1 radius 16 opacity 1 at 16, 12 size 608, 68\n  text \"Job details · {ticket_id}\" at 32, 22 size 300, 26\n  text \"{status}\" at 32, 48 size 560, 22\n\n  # @locked\n  shape rounded as details_card fill #ffffff stroke #dbe3ef stroke-width 1 radius 16 opacity 1 at 16, 92 size 608, 140\n  text \"Customer: {customer}\" at 32, 108 size 270, 22\n  text \"Item: {item}\" at 32, 134 size 270, 22\n  text \"Quantity: {qty}\" at 32, 160 size 270, 22\n  text \"Bench: {ticket_bench}