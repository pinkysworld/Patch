    {
      "path": "model.patch",
      "content": "create thing ticket:\n  id = \"WD-104\"\n  customer_name = \"Ada\"\n  item_name = \"Keyboard\"\n  quantity = 1\n  rush = false\n  priority_name = \"Normal\"\n  payment = \"Card\"\n  notes_text = \"\"\n  services_selected = [\"Diagnostics\"]\n  bench = \"Bench A\"\n  state = \"Open\"\n  quote = 40\n  revision = 0\ncreate thing saved_customer:\n  name = \"Ada\"\n  email = \"ada@example.com\"\n  tier = \"Gold\"\n  marketing = true\n  channels = [\"Email\"]\n  note = \"Priority account\"\n  saves = 0\ncreate thing reorder_request:\n  part = \"Keyboard\"\n  zone = \"Main store\"\n  quantity = 5\n  prepared = false\n\nmake price_services():\n  change service_fee:\n    set = 0\n  if services == [\"Diagnostics\"]:\n    change service_fee:\n      set = 15\n  if services == [\"Warranty\"]:\n    change service_fee:\n      set = 0\n  if services == [\"Install\"]:\n    change service_fee:\n      set = 20\n  if services == [\"Pickup\"]:\n    change service_fee:\n      set = 10\n  if services == [\"Diagnostics\", \"Warranty\"]:\n    change service_fee:\n      set = 15\n  if services == [\"Diagnostics\", \"Install\"]:\n    change service_fee:\n      set = 35\n  if services == [\"Diagnostics\", \"Pickup\"]:\n    change service_fee:\n      set = 25\n  if services == [\"Warranty\", \"Install\"]:\n    change service_fee:\n      set = 20\n  if services == [\"Warranty\", \"Pickup\"]:\n    change service_fee:\n      set = 10\n  if services == [\"Install\", \"Pickup\"]:\n    change service_fee:\n      set = 30\n  if services == [\"Diagnostics\", \"Warranty\", \"Install\"]:\n    change service_fee:\n      set = 35\n  if services == [\"Diagnostics\", \"Warranty\", \"Pickup\"]:\n    change service_fee:\n      set = 25\n  if services == [\"Diagnostics\", \"Install\", \"Pickup\"]:\n    change service_fee:\n      set = 45\n  if services == [\"Warranty\", \"Install\", \"Pickup\"]:\n    change service_fee:\n      set = 30\n  if services == [\"Diagnostics\", \"Warranty\", \"Install\", \"Pickup\"]:\n    change service_fee:\n      set = 45\n\nmake calculate_quote():\n  do price_services()\n  change ticket_total:\n    set = base_rate * qty + service_fee\n  if rush:\n    change ticket_total:\n      add rush_fee\n  if priority == \"High\":\n    change ticket_total:\n      add 10\n  if priority == \"Critical\":\n    change ticket_total:\n      add 25\n\nmake persist_ticket():\n  change ticket:\n    set id = ticket_id\n    set customer_name = customer\n    set item_name = item\n    set quantity = qty\n    set rush = rush\n    set priority_name = priority\n    set payment = pay\n    set notes_text = notes\n    set services_selected = services\n    set bench = ticket_bench\n    set state = ticket_state\n    set quote = ticket_total\n    set revision = quote_revision\n\nmake load_customer_profile():\n  if customer == \"Ada\":\n    change customer_email:\n      set = \"ada@example.com\"\n    change customer_tier:\n      set = \"Gold\"\n    change customer_marketing:\n      set = true\n    change customer_channels:\n      set = [\"Email\"]\n    change customer_note:\n      set = \"Priority account\"\n  if customer == \"Grace\":\n    change customer_email:\n      set = \"grace@example.com\"\n    change customer_tier:\n      set = \"Platinum\"\n    change customer_marketing:\n      set = true\n    change customer_channels:\n      set = [\"Email\", \"Portal\"]\n    change customer_note:\n      set = \"Design team\"\n  if customer == \"Linus\":\n    change customer_email:\n      set = \"linus@example.com\"\n    change customer_tier:\n      set = \"Silver\"\n    change customer_marketing:\n      set = false\n    change customer_channels:\n      set = [\"Portal\"]\n    change customer_note:\n      set = \"Engineering account\"\n  if customer == \"Margaret\":\n    change customer_email:\n      set = \"margaret@example.com\"\n    change customer_tier:\n      set = \"Standard\"\n    change customer_marketing:\n      set = false\n    change customer_channels:\n      set = [\"Phone\"]\n    change customer_note:\n      set = \"Call before pickup\"\n\nmake load_ticket(row):\n  change selected_job:\n    set = row\n  if row == [\"WD-104\", \"Ada\", \"Bench A\", \"Open\"]:\n    change ticket_id:\n      set = \"WD-104\"\n    change customer:\n      set = \"Ada\"\n    change item:\n      set = \"Keyboard\"\n    change qty:\n      set = 1\n    change rush:\n      set = false\n    change priority:\n      set = \"Normal\"\n    change pay:\n      set = \"Card\"\n    change services:\n      set = [\"Diagnostics\"]\n    change ticket_bench:\n      set = \"Bench A\"\n    change ticket_state:\n      set = \"Open\"\n    change quote_revision:\n      set = 0\n  if row == [\"WD-105\", \"Grace\", \"Bench B\", \"Quoted\"]:\n    change ticket_id:\n      set = \"WD-105\"\n    change customer:\n      set = \"Grace\"\n    change item:\n      set = \"Trackpad\"\n    change qty:\n      set = 2\n    change rush:\n      set = false\n    change priority:\n      set = \"High\"\n    change pay:\n      set = \"Account\"\n    change services:\n      set = [\"Diagnostics\", \"Pickup\"]\n    change ticket_bench:\n      set = \"Bench B\"\n    change ticket_state:\n      set = \"Quoted\"\n    change quote_revision:\n      set = 1\n  if row == [\"WD-106\", \"Linus\", \"Bench A\", \"Ready\"]:\n    change ticket_id:\n      set = \"WD-106\"\n    change customer:\n      set = \"Linus\"\n    change item:\n      set = \"Display panel\"\n    change qty:\n      set = 1\n    change rush:\n      set = true\n    change priority:\n      set = \"Critical\"\n    change pay:\n      set = \"Card\"\n    change services:\n      set = [\"Warranty\", \"Install\"]\n    change ticket_bench:\n      set = \"Bench A\"\n    change ticket_state:\n      set = \"Ready\"\n    change quote_revision:\n      set = 2\n  if row == [\"WD-107\", \"Margaret\", \"Overflow\", \"Waiting\"]:\n    change ticket_id:\n      set = \"WD-107\"\n    change customer:\n      set = \"Margaret\"\n    change item:\n      set = \"Display cable\"\n    change qty:\n      set = 3\n    change rush:\n      set = false\n    change priority:\n      set = \"Normal\"\n    change pay:\n      set = \"Cash\"\n    change services:\n      set = [\"Pickup\"]\n    change ticket_bench:\n      set = \"Overflow\"\n    change ticket_state:\n      set = \"Waiting\"\n    change quote_revision:\n      set = 0\n  do load_customer_profile()\n  do calculate_quote()\n  do persist_ticket()\n\nmake select_part(path):\n  change selected_part:\n    set = path\n  if path == [\"Parts\", \"Input\", \"Keyboard\"]:\n    change item:\n      set = \"Keyboard\"\n  if path == [\"Parts\", \"Input\", \"Trackpad\"]:\n    change item:\n      set = \"Trackpad\"\n  if path == [\"Parts\", \"Displays\", \"Panel\"]:\n    change item:\n      set = \"Display panel\"\n  if path == [\"Parts\", \"Displays\", \"Cable\"]:\n    change item:\n      set = \"Display cable\"\n  if path == [\"Tools\", \"Driver\"]:\n    change item:\n      set = \"Precision driver\"\n  if path == [\"Tools\", \"Solder\"]:\n    change item:\n      set = \"Solder\"\n  if path == [\"Tools\", \"Meter\"]:\n    change item:\n      set = \"Meter\"\n  change inventory_filter:\n    set = item\n  do calculate_quote()\n  do persist_ticket()\n\nmake quote_ticket():\n  do calculate_quote()\n  change quote_revision:\n    add 1\n  change ticket_state:\n    set = \"Quoted\"\n  do persist_ticket()\n  change status:\n    set = ticket_id + \" quoted at \" + ticket_total + \" · revision \" + quote_revision\n\nmake save_customer():\n  change customer_saves:\n    add 1\n  change saved_customer:\n    set name = customer\n    set email = customer_email\n    set tier = customer_tier\n    set marketing = customer_marketing\n    set channels = customer_channels\n    set note = customer_note\n    set saves = customer_saves\n  change customer_status:\n    set = customer + \" profile saved · revision \" + customer_saves\n  change status:\n    set = \"Customer profile persisted for \" +