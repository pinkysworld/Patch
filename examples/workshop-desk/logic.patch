when diagnostic_run clicked:
  change diagnostic_runs:
    add 1
  if trace_enabled:
    change diagnostic_status:
      set = "Trace checks passed in " + diagnostic_mode + " mode · run " + diagnostic_runs
  else:
    change diagnostic_status:
      set = "Runtime checks passed in " + diagnostic_mode + " mode · run " + diagnostic_runs
  change status:
    set = "Diagnostics completed"

when diagnostics_clock ticked:
