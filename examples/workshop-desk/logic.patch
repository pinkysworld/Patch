when customer changed:
  change customer:
    set = value
  do load_customer_profile()
  do persist_ticket()
  change status:
    set = "Loaded customer profile for " + customer

when item changed:
  change item:
    set = value
  do calculate_quote()
  do persist_ticket()
  change status:
    set = "Item updated · estimate " + ticket_total

