create text user_name = "Ada"
create text secret = ""
create text phone = ""
create text notes = "Patch Studio Showcase keeps the complete current Studio/Web surface visible in one project."
create boolean active = true
create text access = "User"
create text theme = "Blue"
create list features = ["Designer", "Web"]
create number level = 60
create number completion = 35
create number scroll_position = 25
create text status = "Patch Studio Showcase ready"
create boolean can_save = true
create boolean pinned = false
create text selected_path = "No file selected"
create number ticks = 0
create text nested_code = ""
create text nested_number = "42"
create text review_date = "2026-09-10"
create text review_time = "14:30"
create text calendar_date = "2026-09-12"
create text calendar_status = "Calendar ready"
create text gallery_status = "Component Gallery ready"
create text dialog_status = "Dialogs ready"
create text split_status = "SplitContainer ready"
create list tree_path = ["Workspace"]
create text tree_status = "Tree Lab ready"
create text profile_summary = "Ada · User · 2026-09-10 14:30"
create number profile_saves = 0
create thing profile:
  name = "Ada"
  code = ""
  phone_number = ""
  role = "User"
  theme_name = "Blue"
  level = 60
  active = true
  slot = "2026-09-10 14:30"
  progress = 35
  surfaces = ["Designer", "Web"]

make save_profile():
  change profile:
    set name = user_name
    set code = nested_code
    set phone_number = phone
    set role = access
    set theme_name = theme
    set level = level
    set active = active
    set slot = review_date + " " + review_time
    set progress = completion
    set surfaces = features
  change profile_saves:
    add 1
  if active:
    change profile_summary:
      set = user_name + " · " + access + " · " + review_date + " " + review_time
    change status:
      set = "Saved review profile · " + user_name + " · " + access + " · " + review_date
  else:
    change profile_summary:
      set = "Inactive " + user_name
    change status:
      set = "Saved inactive profile for " + user_name

make reset_showcase():
  change user_name:
    set = "Ada"
  change secret:
    set = ""
  change phone:
    set = ""
  change notes:
    set = "Patch Studio Showcase keeps the complete current Studio/Web surface visible in one project."
  change active:
    set = true
  change access:
    set = "User"
  change theme:
    set = "Blue"
  change features:
    set = ["Designer", "Web"]
  change level:
    set = 60
  change completion:
    set = 35
  change selected_path:
    set = "No file selected"
  change nested_code:
    set = ""
  change nested_number:
    set = "42"
  change review_date:
    set = "2026-09-10"
  change review_time:
    set = "14:30"
  change profile:
    set name = "Ada"
    set code = ""
    set phone_number = ""
    set role = "User"
    set theme_name = "Blue"
    set level = 60
    set active = true
    set slot = "2026-09-10 14:30"
    set progress = 35
    set surfaces = ["Designer", "Web"]
  change profile_summary:
    set = "Ada · User · 2026-09-10 14:30"
  change profile_saves:
    set = 0
  change status:
    set = "Showcase restored to its demo defaults"

window "Patch Studio Showcase" as main size 1180, 820 icon "patch-resource:showcase.logo":
  menu "File":
    item "Open file..." as menu_open shortcut "Primary+O"
    item "Save file..." as menu_save enabled can_save shortcut "Primary+S"
    separator
    item "Pinned" as menu_pinned checked pinned shortcut "Primary+P"
  menu "View":
    item "Component Gallery" as menu_gallery
    item "Dialog Lab" as menu_dialogs
    item "Tree Lab" as menu_tree
  menu "Help":
    item "About Showcase" as menu_about shortcut "F1"

  # @locked
  shape rounded as hero_card fill #eef2ff stroke #c7d2fe stroke-width 1 radius 22 opacity 1 at 24, 18 size 1132, 92
  # @locked
  picture as showcase_logo from "patch-resource:showcase.logo" description "Patch Studio Showcase logo" at 44, 36 size 56, 56
  text "Patch Studio Showcase" at 120, 34 size 430, 34
  text "Saved " + profile.name + " · " + profile.slot + " · editing " + user_name at 120, 68 size 660, 24
  text "{status}" at 824, 42 size 300, 42

  imagelist as showcase_images size 20, 20:
    image mark from "patch-resource:showcase.logo"

  # @locked
  shape rounded as account_card fill #ffffff stroke #dbe3ef stroke-width 1 radius 18 opacity 1 at 24, 132 size 548, 280
  text "Reviewer & input modes" at 44, 150 size 300, 28
  text "Password, mask and Memo stay ordinary source-backed inputs in one reviewer workflow." at 44, 180 size 492, 38

  text "Reviewer" at 44, 226 size 120, 20
  # @taborder 0
  input user_name at 44, 250 size 236, 38
  text "Review token" at 306, 226 size 120, 20
  # @input-mode password
  # @taborder 1
  input secret at 306, 250 size 236, 38

  text "Phone" at 44, 302 size 120, 20
  # @input-mask "(000) 000-0000"
  # @taborder 2
  input phone at 44, 326 size 236, 38
  text "Notes" at 306, 302 size 120, 20
  # @taborder 3
  memo notes at 306, 326 size 236, 66

  # @locked
  shape rounded as preference_card fill #ffffff stroke #dbe3ef stroke-width 1 radius 18 opacity 1 at 596, 132 size 560, 280
  text "Review preferences" at 616, 150 size 280, 28
  text "Interactive controls emit transient values. Only explicit change blocks persist them." at 616, 180 size 504, 38

  checkbox "Review active" as active at 616, 226 size 200, 34
  radio "User", "Admin", "Guest" as access at 616, 268 size 218, 78

  text "Theme" at 860, 226 size 100, 20
  combo "Blue", "Green", "Amber", "System" as theme at 860, 250 size 260, 38
  text "Enabled surfaces" at 860, 300 size 160, 20
  # @listbox-mode checked
  listbox "Designer", "Web", "Native", "Offline" as features at 860, 324 size 260, 68

  text "Experience level {level}" at 616, 354 size 200, 20
  slider 0..100 as level step 10 at 616, 378 size 218, 26
  text "Demo progress {completion}%" at 860, 354 size 200, 20
  # @slider-mode progress
  slider 0..100 as completion step 1 at 860, 378 size 260, 26

  # @locked
  shape rounded as details_card fill #ffffff stroke #dbe3ef stroke-width 1 radius 18 opacity 1 at 24, 436 size 732, 318
  text "Project & semantics" at 44, 454 size 280, 28
  text "Tabs keep secondary concepts available without crowding the primary dashboard." at 44, 484 size 660, 24
  tabs as showcase_tabs at 44, 516 size 692, 218:
    tab "Nested controls":
      text "Save here or with Save profile. The recipe stores this review on the profile Thing."
      # @input-mask "AA-000"
      input nested_code
      # @number-edit
      input nested_number
      # @input-mode date
      input review_date
      # @input-mode time
      input review_time
      text "Review slot {review_date} at {review_time}"
      button "Save profile" as nested_apply
    tab "Project v4":
      text "Resources, multiple .patch files, recovery and build settings belong to the explicit project bundle."
      picture as nested_picture from "patch-resource:showcase.logo" description "Project resource preview"
    tab "Semantics":
      text "Persistent application state changes only through explicit change blocks."
      text "save_profile copies this review onto a Thing, branches on active state, and reset_showcase restores the acceptance fixture."

  # @layout anchor right bottom
  panel as actions_panel at 780, 436 size 376, 318:
    text "Quick actions" at 20, 16 size 220, 26
    text "Save writes this review onto the profile Thing. Labs open the complete feature surface." at 20, 44 size 336, 36
    button "Save profile" as save_button at 20, 86 size 336, 40
    button "Component Gallery" as open_gallery image showcase_images.mark at 20, 136 size 160, 36
    button "Dialog Lab" as open_dialogs at 196, 136 size 160, 36
    button "Confirm reset" as confirm_reset at 20, 180 size 160, 36
    button "About" as about_button at 196, 180 size 160, 36
    text "Selected file" at 20, 226 size 160, 18
    text "{selected_path}" at 20, 246 size 336, 40

  timer as showcase_clock interval 4000
  # @layout anchor left right bottom
  statusbar "{status} · saves {profile_saves} · timer {ticks}" as showcase_status at 0, 792 size 1180, 28
