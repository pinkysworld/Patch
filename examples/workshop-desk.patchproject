gnostic_mode:\n    set = \"Runtime\"\n  change trace_enabled:\n    set = true\n  change diagnostic_interval:\n    set = 5\n  change diagnostic_runs:\n    set = 0\n  change diagnostic_ticks:\n    set = 0\n  change diagnostic_status:\n    set = \"All systems ready\"\n  change gallery_text:\n    set = \"Workshop sample\"\n  change gallery_enabled:\n    set = true\n  change gallery_mode:\n    set = \"Ready\"\n  change gallery_color:\n    set = \"Blue\"\n  change gallery_features:\n    set = [\"Designer\"]\n  change gallery_level:\n    set = 60\n  change gallery_status:\n    set = \"Component gallery ready\"\n  change gallery_ticks:\n    set = 0\n  change gallery_memo:\n    set = \"Feature Lab notes\"\n  change gallery_secret:\n    set = \"\"\n  change gallery_mask:\n    set = \"\"\n  change gallery_number:\n    set = \"42\"\n  change gallery_date:\n    set = \"2026-09-25\"\n  change gallery_time:\n    set = \"14:30\"\n  change gallery_calendar:\n    set = \"2026-09-25\"\n  change gallery_progress:\n    set = 40\n  change gallery_scroll:\n    set = 25\n  change gallery_path:\n    set = \"No file selected\"\n  do calculate_quote()\n  do persist_ticket()\n  change status:\n    set = \"Ticket reset to WD-104\"\n"
