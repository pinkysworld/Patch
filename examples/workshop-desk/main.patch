window "Studio Feature Lab" as components size 980, 700:
  menu "Lab":
    item "Confirm action..." as gallery_menu_confirm shortcut "Primary+K"
    item "Open file..." as gallery_menu_open shortcut "Primary+O"
    item "Save file..." as gallery_menu_save shortcut "Primary+S"
    separator
    item "Enabled" as gallery_menu_enabled checked gallery_enabled shortcut "Primary+E"
  menu "Help":
    item "About Feature Lab" as gallery_menu_about shortcut "F1"

  # @locked
  shape rounded as gallery_header fill #ecfeff stroke #bae6fd stroke-width 1 radius 18 opacity 1 at 16, 12 size 948, 64
  text "Studio Feature Lab" at 32, 22 size 300, 26
  text "{gallery_status}" at 346, 22 size 590, 26
  text "Complete current Studio/Web acceptance surface · Component Registry 0.10" at 32, 48 size 700, 20

  text "Project-v4 adds ImageList-backed icons from workshop.mark; the standalone source remains resource-free." at 32, 78 size 820, 18

  imagelist as gallery_images size 20, 20:
    image mark from "patch-resource:workshop.mark"

  tabs as feature_tabs at 16, 100 size 948, 318:
    tab "Inputs":
      text "Text, Memo and all current source-backed Input presentations"
      input gallery_text
      memo gallery_memo
      # @input-mode password
      input gallery_secret
      # @input-mask "AA-000"
      input gallery_mask
      # @number-edit
      input gallery_number
      # @input-mode date
      input gallery_date
      # @input-mode time
      input gallery_time
    tab "Choices":
      text "Core choices plus CheckedListBox, ProgressBar, ScrollBar and LinkLabel"
      checkbox "Enabled" as gallery_enabled
      radio "Ready", "Review", "Blocked" as gallery_mode
      combo "Blue", "Green", "Amber", "Red" as gallery_color
      # @listbox-mode checked
      listbox "Designer", "Compiler", "Runtime", "Offline" as gallery_features
      slider 0..100 as gallery_level step 10
      # @slider-mode progress
      slider 0..100 as gallery_progress step 1
      # @slider-mode scrollbar
      slider 0..100 as gallery_scroll step 5
      # @button-mode link
      button "LinkLabel action" as gallery_link
    tab "Calendar":
      text "Calendar Stage 1 keeps ISO date text in ordinary Patch state"
      # @input-mode calendar
      input gallery_calendar
      text "Selected date {gallery_calendar}"
    tab "Data":
      text "Advanced Table columns and TreeView node image, hint and state metadata"
      # @table-columns 150:left, 180:left, 120:center
      table "Component", "Contract", "Surface" as gallery_table:
        row "Memo", "changed(value)", "Studio/Web"
        row "Calendar", "ISO date text", "Studio/Web"
        row "TreeView", "path list", "Studio/Web"
        row "Table", "advanced columns", "Studio/Web"
      tree as gallery_tree:
        node "Component Registry 0.10" image gallery_images.mark hint "Feature Lab root" state info
          node "Inputs" image gallery_images.mark hint "Input presentations" state success
            node "Memo" image gallery_images.mark hint "Multiline text" state muted
          node "Data" image gallery_images.mark hint "Structured controls" state warning
            node "TreeView" image gallery_images.mark hint "Node metadata" state success
    tab "Containers":
      text "GroupBox, ScrollBox and SplitContainer are shown below the tabs because container controls stay top-level in Tabs Stage 1."
      button "Focus container demos" as gallery_container_focus
    tab "Graphics":
      text "Project graphics, Separator preset, PaintBox and ImageList-backed Button"
      picture as gallery_picture from "patch-resource:workshop.mark" description "Workshop Feature Lab picture"
      # @locked
      shape rounded as gallery_shape fill #dbeafe stroke #2563eb stroke-width 2 radius 14 opacity 1
      # @locked
      shape line as gallery_separator fill transparent stroke #94a3b8 stroke-width 1 radius 0 opacity 1
      paintbox as gallery_canvas
      button "Resource button" as gallery_resource_button image gallery_images.mark

  # @panel-mode group
  panel as gallery_group at 16, 432 size 300, 160:
    text "GroupBox presentation"
    button "Group action" as gallery_group_action

  # @panel-scroll auto
  panel as gallery_scrollbox at 328, 432 size 300, 160:
    text "ScrollBox keeps viewport state transient"
    button "ScrollBox action" as gallery_scroll_action
    text "Overflow content exercises a real scroll viewport."
    text "No hidden application state is created by scrolling."

  panel as gallery_split at 640, 432 size 324, 160:
    # @panel-split vertical 42
    text "Navigator pane"
    button "Navigate" as gallery_split_left
    # @panel-split-break
    text "Preview pane"
    button "Preview" as gallery_split_right

  button "Refresh demo" as gallery_refresh image gallery_images.mark at 620, 620 size 160, 32
  button "Close Feature Lab" as close_components at 792, 620 size 172, 32
  timer as gallery_clock interval 2000
  statusbar "{gallery_status} · progress {gallery_progress}% · pulse {gallery_ticks}" as gallery_statusbar at 0, 672 size 980, 28
