when gallery_canvas paint:
  draw clear #f8fafc
  draw rectangle 10, 10 size 54, 28 fill #dbeafe stroke #2563eb width 2
  draw ellipse 76, 10 size 28, 28 fill #dcfce7 stroke #16a34a width 2
  draw image "patch-resource:workshop.mark" at 118, 8 size 36, 36
  draw line 10, 48 to 154, 48 stroke #64748b width 2
  draw text gallery_mode at 10, 66 color #111827 size 14

when gallery_menu_confirm clicked:
  confirm "Feature Lab", "Persist a confirmation result?" as gallery_confirm_result

when gallery_confirm_result confirmed:
  change gallery_status:
    set = "Confirmation accepted and persisted"

when gallery_confirm_result cancelled:
  change gallery_status:
    set = "Confirmation cancelled"

when gallery_menu_open clicked:
  open file "Choose a Patch file" as gallery_open_result

when gallery_open_result chosen:
  change gallery_path:
    set = value
  change gallery_status:
    set = "Open-file result persisted: " + value

when gallery_open_result cancelled:
  change gallery_status:
    set = "Open file cancelled"

when gallery_menu_save clicked:
  save file "Choose a Patch save name" as gallery_save_result

when gallery_save_result chosen:
  change gallery_path:
    set = value
  change gallery_status:
    set = "Save-file result persisted: " + value

when gallery_save_result cancelled:
  change gallery_status:
    set = "Save file cancelled"

when gallery_menu_enabled clicked:
  if gallery_enabled:
    change gallery_enabled:
      set = false
  else:
    change gallery_enabled:
      set = true
  change gallery_status:
    set = "Menu checked state changed explicitly"

when gallery_menu_about clicked:
  dialog "Studio Feature Lab", "Workshop keeps the business workflow focused while this tabbed lab exercises the complete current Studio/Web authoring surface."

when gallery_clock ticked:
  change gallery_ticks:
    add 1
  if gallery_progress >= 100:
    change gallery_progress:
      set = 0
  else:
    change gallery_progress:
      add 10

when gallery_refresh clicked:
  change gallery_ticks:
    add 1
  change gallery_progress:
    set = 100
  change gallery_status:
    set = "Feature Lab refreshed · all demonstrations ready"

when close_components clicked:
  close components
  change status:
    set = "Studio Feature Lab closed"

when reset_button clicked:
  do reset_workshop()
