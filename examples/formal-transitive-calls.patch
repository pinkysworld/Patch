create number score = 0
create number coins = 0

make leaf(amount number 1..5):
  change score:
    add amount

make middle(amount number 1..4):
  do leaf(amount + 1)
  change coins:
    add amount

make outer(seed number 0..3):
  do middle(seed + 1)

make caller(seed number 0..2):
  do outer(seed + 1)

do caller(1)
show score
show coins
