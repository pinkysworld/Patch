when parts changed:
  do select_part(value)
  change status:
    set = "Working item changed to " + item + " · Inventory is ready"

when workshop_logo clicked:
  change status:
    set = "Workshop Desk project mark · source-backed UI"

when workshop_clock ticked:
  change heartbeat:
    add 1

when ticket_canvas paint:
  draw clear #f8fafc
  draw rectangle 12, 12 size 118, 34 fill #dbeafe stroke #2563eb width 2
  draw ellipse 146, 12 size 34, 34 fill #dcfce7 stroke #16a34a width 2
  draw image "patch-resource:workshop.mark" at 208, 10 size 42, 42
  if rush:
    draw line 12, 58 to 258, 58 stroke #dc2626 width 3
  draw text ticket_id at 12, 78 color #111827 size 16
  draw text ticket_state at 126, 78 color #334155 size 16

when quote_button clicked:
  do quote_ticket()

when details_quote clicked:
  do quote_ticket()

when complete_button clicked:
  change ticket_state:
    set = "Ready"
  do persist_ticket()
  change status:
    set = ticket_id + " marked ready"

when details_ready clicked:
  change ticket_state:
    set = "Ready"
  do persist_ticket()
  change status:
    set = ticket_id + " marked ready"

when settings_button clicked:
  open settings

when details_button clicked:
