when user_name changed:
  change user_name:
    set = value
  change status:
    set = "Account name updated"

when secret changed:
  change secret:
    set = value
  change status:
    set = "PasswordEdit updated securely"

when phone changed:
  change phone:
    set = value
  change status:
    set = "Masked phone input updated"

when notes changed:
  change notes:
    set = value
  change status:
    set = "Notes updated"

when active changed:
  change active:
    set = value
  change status:
    set = "Account activity changed"

when access changed:
  change access:
    set = value
  change status:
    set = "Access role changed"

when theme changed:
  change theme:
    set = value
  change status:
    set = "Theme preference changed"

when features changed:
  change features:
    set = value
  change status:
    set = "Enabled surfaces changed"

when level changed:
  change level:
    set = value
  change status:
    set = "Experience level changed"

when nested_code changed:
  change nested_code:
    set = value
  change status:
    set = "Nested masked input updated"

when nested_apply clicked:
  change status:
    set = "Nested code applied"

when showcase_logo clicked:
  change status:
    set = "Project resource selected"

when showcase_clock ticked:
  change ticks:
    add 1
  if completion >= 100:
    change completion:
      set = 0
  else:
    change completion:
      add 5

when open_gallery clicked:
  open components
  change gallery_status:
    set = "Component Gallery opened from dashboard"

when open_dialogs clicked:
  open dialogs
  change dialog_status:
    set = "Dialog Lab opened from dashboard"

when menu_gallery clicked:
  open components
  change gallery_status:
    set = "Component Gallery opened from menu"

when menu_dialogs clicked:
  open dialogs
  change dialog_status:
    set = "Dialog Lab opened from menu"

when menu_pinned clicked:
  if pinned:
    change pinned:
      set = false
  else:
    change pinned:
      set = true
  change status:
    set = "Pinned menu state changed explicitly"

when menu_about clicked:
  dialog "Patch Studio Showcase", "A polished Project-v4 workspace for Component Registry 0.10 and current Studio/Web RAD features."

when about_button clicked:
  dialog "About", "Patch Studio Showcase combines a dashboard, Component Gallery and Dialog Lab while keeping persistent state changes explicit."

when menu_open clicked:
  open file "Choose a Patch file" as menu_open_result

when menu_open_result chosen:
  change selected_path:
    set = value
  change status:
    set = "Selected file persisted explicitly"

when menu_open_result cancelled:
  change status:
    set = "Open file cancelled"

when menu_save clicked:
  save file "Save Patch project data" as menu_save_result

when menu_save_result chosen:
  change selected_path:
    set = value
  change status:
    set = "Save path persisted explicitly"

when menu_save_result cancelled:
  change status:
    set = "Save file cancelled"

when confirm_reset clicked:
  confirm "Reset showcase?", "Restore the dashboard progress, level, selected path and status?" as reset_confirm

when reset_confirm confirmed:
  change selected_path:
    set = "No file selected"
  change level:
    set = 60
  change completion:
    set = 35
  change status:
    set = "Showcase restored to its demo defaults"

when reset_confirm cancelled:
  change status:
    set = "Reset cancelled"

when gallery_table changed:
  change gallery_status:
    set = "Component contract selected"

when gallery_tree changed:
  change gallery_status:
    set = "Registry tree selection changed"

when gallery_picture clicked:
  change gallery_status:
    set = "Project Picture resource selected"

when gallery_resource_button clicked:
  change gallery_status:
    set = "ImageList-backed Button clicked"

when gallery_update clicked:
  change gallery_status:
    set = "Panel child action completed"

when gallery_canvas paint:
  draw clear #f8fafc
  draw rectangle 10, 10 size 58, 30 fill #dbeafe stroke #2563eb width 2
  draw ellipse 82, 10 size 30, 30 fill #dcfce7 stroke #16a34a width 2
  draw image "patch-resource:showcase.logo" at 102, 56 size 36, 36
  draw line 10, 50 to 138, 50 stroke #64748b width 2
  draw text "Patch" at 10, 76 color #111827 size 14

when gallery_dialogs clicked:
  open dialogs
  change dialog_status:
    set = "Dialog Lab opened from Component Gallery"

when close_gallery clicked:
  close components
  change status:
    set = "Returned to Showcase dashboard"

when dialog_confirm clicked:
  confirm "Confirm showcase action", "Persist a confirmation status?" as dialog_confirm_result

when dialog_confirm_result confirmed:
  change dialog_status:
    set = "Confirmation accepted and persisted"

when dialog_confirm_result cancelled:
  change dialog_status:
    set = "Confirmation cancelled"

when dialog_open clicked:
  open file "Open any file" as dialog_open_result

when dialog_open_result chosen:
  change selected_path:
    set = value
  change dialog_status:
    set = "Open-file result persisted explicitly"

when dialog_open_result cancelled:
  change dialog_status:
    set = "Open file cancelled"

when dialog_save clicked:
  save file "Choose save path" as dialog_save_result

when dialog_save_result chosen:
  change selected_path:
    set = value
  change dialog_status:
    set = "Save-file result persisted explicitly"

when dialog_save_result cancelled:
  change dialog_status:
    set = "Save file cancelled"

when dialog_info clicked:
  dialog "Informational dialog", "Informational dialogs carry no hidden persistent result state."

when dialog_gallery clicked:
  open components
  change gallery_status:
    set = "Returned from Dialog Lab"

when close_dialogs clicked:
  close dialogs
  change status:
    set = "Returned to Showcase dashboard"
