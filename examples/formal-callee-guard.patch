create number score = 0
create number coins = 0

make award(amount number 1..5):
  if amount >= 3:
    change score:
      add amount
  else:
    change coins:
      add amount * 2

make caller_high(bonus number 0..4):
  do award(bonus + 1)

make caller_low(bonus number 0..4):
  do award(bonus + 1)

do caller_high(2)
do caller_low(0)
show score
show coins
